PORT=3000
NODE_ENV=production

# Google Identity Services Web client ID; authorized JavaScript origin must include the site domain.
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional private account-store path. Defaults to $HOME/credentials in production.
# CREDENTIALS_DIR=/home/your-account/credentials

# Optional override for submission storage. By default, production saves under
# $HOME/tmp/uploads; local development uses ./tmp/uploads.
# UPLOAD_DIR=/home/your-account/tmp/uploads

APP_BASE_URL=https://goadharma.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@goadharma.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=goadharma <noreply@goadharma.com>

# Admin email address(es) for notifications and console access. Separate multiple addresses with semicolons.
ADMIN_EMAIL_FOR_NOTIFICATION=vardhni.karthik@gmail.com
