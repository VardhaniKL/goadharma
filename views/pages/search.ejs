<%- include('../partials/head',{title}) %><body><%- include('../partials/header') %><main class="search-page"><section class="section"><div class="wrap"><div class="eyebrow"><i></i> SEARCH goadharma</div><h1>Find what you’re<br>looking <span>for.</span></h1><form class="search-page-form" action="/search" method="get" role="search"><label for="searchQuery">Search the site</label><div><input id="searchQuery" name="q" type="search" value="<%= query %>" placeholder="Services, careers, locations…" required><button class="btn primary" type="submit">Search</button></div></form><% if(query){ %><h2 class="search-results-title">Results for <%= query %></h2><% if(results.length){ %><div class="search-results"><% results.forEach(result=>{ %><a href="<%= result.href %>"><span>goadharma</span><h3><%= result.title %></h3><p><%= result.description %></p></a><% }) %></div><% }else{ %><p>No matches found. Try searching for services, careers, or locations.</p><% } %><% }else{ %><p>Search services, opportunities, and worldwide locations.</p><% } %></div></section></main><%- include('../partials/footer') %>