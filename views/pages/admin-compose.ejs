<%- include('../partials/head',{title}) %>
<body><%- include('../partials/header') %><main class="section admin-compose-page"><div class="wrap"><a class="admin-compose-back" href="/admin/inbox">&larr; Back to Admin Console</a><div class="section-head"><div><div class="eyebrow"><i></i> ADMIN</div><h1>Compose email</h1></div></div><section class="admin-reply-panel admin-compose-panel"><form id="adminComposeForm" enctype="multipart/form-data"><label>To<input name="to" type="email" required maxlength="254" autocomplete="email"></label><label>BCC (optional)<input name="bcc" type="email" maxlength="254" placeholder="One address"></label><label>Subject<input name="subject" required maxlength="200"></label><label>Message<textarea name="body" required maxlength="10000" rows="12"></textarea></label><label>Attachment (optional)<input name="attachment" type="file"><small>Maximum 5 MB.</small></label><div class="admin-compose-actions"><button class="btn primary" type="submit">Send email</button><a class="btn admin-compose-cancel" href="/admin/inbox">Cancel</a></div><p id="adminComposeStatus" role="status" aria-live="polite"></p></form></section></div></main><dialog class="admin-compose-success" id="adminComposeSuccess" aria-labelledby="adminComposeSuccessTitle"><div class="eyebrow"><i></i> SENT</div><h2 id="adminComposeSuccessTitle">Email sent successfully</h2><p>Your message and any attachment were saved in Sent.</p><button class="btn primary" id="returnToAdminConsole" type="button">View Sent</button></dialog><script src="/assets/js/admin-compose.js?v=20261103-2" defer></script><%- include('../partials/footer') %>
