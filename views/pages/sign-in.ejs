<%- include('../partials/head',{title}) %>
<body><%- include('../partials/header') %><main class="section"><div class="wrap" style="max-width:560px"><% if (verified) { %><div class="email-verified-notice" role="status"><b>Email confirmed.</b> Your account is active. Please sign in again, then choose the role you want to apply for.</div><% } %><% if (currentUser) { %><section class="application-auth"><h2>You’re signed in</h2><p>Signed in as <b><%= currentUser.email || currentUser.username %></b></p><div class="signed-in-actions"><a class="btn primary" href="/careers#open-roles">Explore open roles</a><button class="auth-secondary-button" type="button" data-auth-action="signout" data-redirect="/">Sign out</button><button class="auth-secondary-button" type="button" data-auth-action="switch" data-redirect="/careers/sign-in?switch=1">Switch account</button></div></section><% } else { %><section class="application-auth" id="applicationAuth" data-google-client-id="<%= googleOAuthClientId %>"><h2>Sign in</h2><div class="application-auth-tabs" role="tablist"><button class="active" id="showLogin" type="button" role="tab" aria-selected="true">Sign in</button><button id="showSignup" type="button" role="tab" aria-selected="false">Create account</button></div><form class="application-auth-form" id="applicationLoginForm"><label>Username<input name="username" autocomplete="username" required maxlength="32"></label><label>Password<input name="password" type="password" autocomplete="current-password" required maxlength="128"></label><button class="btn primary" type="submit">Sign in</button><button class="auth-text-button" id="showForgot" type="button">Forgot password?</button></form><form class="application-auth-form" id="applicationSignupForm" hidden><label>Username<input name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[A-Za-z0-9][A-Za-z0-9._-]{2,31}"></label><label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254"></label><label>Password<input name="password" type="password" autocomplete="new-password" required minlength="6" maxlength="128" pattern="(?=.*[0-9])(?=.*[^A-Za-z0-9\s]).{6,128}"><small class="application-auth-hint">At least 6 characters, including a number and a special character.</small></label><label>Confirm password<input name="confirmPassword" type="password" autocomplete="new-password" required minlength="6" maxlength="128" pattern="(?=.*[0-9])(?=.*[^A-Za-z0-9\s]).{6,128}"></label><button class="btn primary" type="submit">Create account</button></form><form class="application-auth-form" id="applicationForgotForm" hidden><label>Email address<input name="email" type="email" required maxlength="254"></label><button class="btn primary" type="button" id="sendResetCode">Send reset code</button><label>Reset code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></label><label>New password<input name="password" type="password" minlength="6" maxlength="128" pattern="(?=.*[0-9])(?=.*[^A-Za-z0-9\s]).{6,128}" required></label><label>Confirm new password<input name="confirmPassword" type="password" minlength="6" maxlength="128" required></label><button class="btn primary" type="button" id="resetPasswordButton">Replace password</button><button class="auth-text-button" id="backToLogin" type="button">Back to sign in</button></form><div class="application-auth-divider"><span>or</span></div><div class="google-signin-wrap"><div id="googleSignInButton"><button type="button" class="google-signin-fallback"><span class="google-mark">G</span>Continue with Google</button></div></div><p class="application-auth-status" id="applicationAuthStatus" role="status" aria-live="polite"></p></section><% } %></div></main><% if (!currentUser && googleOAuthClientId) { %><script src="https://accounts.google.com/gsi/client" defer></script><% } %><script src="/assets/js/application.js?v=20261031-application-auth-8" defer></script><%- include('../partials/footer') %>