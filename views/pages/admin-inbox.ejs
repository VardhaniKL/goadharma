<%- include('../partials/head',{title}) %>
<body><%- include('../partials/header') %><main class="section admin-inbox-page"><div class="wrap"><div class="section-head"><div><div class="eyebrow"><i></i> ADMIN</div><h1>Admin Console</h1><p>Manage incoming communications and generate offer letters.</p></div></div><nav class="admin-console-tabs" aria-label="Admin sections"><a href="/admin/inbox" aria-current="page">Communications</a><a href="/admin/offers">Offers</a></nav><div class="section-head admin-subhead"><div><div class="eyebrow"><i></i> COMMUNICATIONS</div><h2>Communications</h2></div><div class="admin-inbox-actions"><a href="/admin/compose" class="btn primary">Compose New</a><button id="refreshAdminInbox" class="btn primary" type="button">Refresh</button></div></div><div class="admin-communication-tabs" role="tablist" aria-label="Communication folders"><button id="showInboxTab" class="active" type="button" role="tab" aria-selected="true">Inbox</button><button id="showSentTab" type="button" role="tab" aria-selected="false">Sent</button></div><p class="admin-inbox-status" id="adminInboxStatus" role="status">Loading submissions…</p><div class="admin-inbox-layout"><section id="adminInboxList" class="admin-inbox-list" aria-label="Received submissions"></section><section id="adminSentList" class="admin-inbox-list" aria-label="Sent messages" hidden></section><section class="admin-reply-panel" id="adminReplyPanel" hidden><h2>Reply by email</h2><form id="adminReplyForm" enctype="multipart/form-data"><label>To<input name="to" type="email" required maxlength="254"></label><label>BCC (optional)<input name="bcc" type="email" maxlength="254" placeholder="One address"></label><label>Subject<input name="subject" required maxlength="200"></label><label>Message<textarea name="body" required maxlength="10000" rows="9"></textarea></label><label>Attachment (optional)<input name="attachment" type="file"><small>Maximum 5 MB.</small></label><button class="btn primary" type="submit">Send reply</button><p id="adminReplyStatus" role="status"></p></form></section></div></div></main><script src="/assets/js/admin-inbox.js?v=20261103-2" defer></script><%- include('../partials/footer') %>
