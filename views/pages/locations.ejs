<%- include('../partials/head',{title}) %><body><%- include('../partials/header') %><main class="locations-page">
<div class="worldwide-bar"><div class="wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path></svg> Worldwide</div></div>
<div class="wrap"><p class="eyebrow">goadharma AROUND THE WORLD</p></div>
<section class="section locations-content"><div class="wrap"><div class="careers-intro"><div><h2>Our Global Presence</h2></div></div>
<div class="region-tabs" role="tablist" aria-label="Filter locations"><button type="button" role="tab" aria-selected="true" data-region-filter="all">Worldwide</button><button type="button" role="tab" aria-selected="false" data-region-filter="Americas">Americas</button><button type="button" role="tab" aria-selected="false" data-region-filter="Europe">Europe</button><button type="button" role="tab" aria-selected="false" data-region-filter="Asia">Asia</button><button type="button" role="tab" aria-selected="false" data-region-filter="Oceania">Oceania</button></div>
<div class="country-grid"><% countries.forEach((country,index)=>{ %><a class="country-card" data-region="<%= country.region %>" href="/<%= country.code %>"><span class("country-index"><%= String(index+1).padStart(2,'0') %></span><span class("country-region"><%= country.region %></span><strong><%= country.name %></strong><span class("country-link">Visit country page &#8599;</span></a><% }) %></div></div></section></main><%- include('../partials/footer') %>