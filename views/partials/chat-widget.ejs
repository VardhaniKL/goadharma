<aside class="chat-widget">
<section class="chat-panel" id="chatPanel" aria-label="goadharma chat" hidden>
<header class="chat-header"><span class="chat-avatar" aria-hidden="true">eT</span><span><strong>goadharma</strong><small>Quick answers &amp; questions</small></span><button class="chat-close" type="button" aria-label="Close chat">×</button></header>
<div id="chatContent">
<div class="chat-messages" id="chatMessages" role="log" aria-live="polite"><div class="chat-message bot">Hi! Ask me about our services, or how to reach our team.</div></div>
<p class="chat-disclaimer">Messages and attachments are saved on this website server for our team to review. Please don’t send passwords or highly sensitive information.</p>
<form class="chat-form" id="chatForm" onsubmit="return false"><div class="chat-compose"><input type="text" name="message" required minlength="2" maxlength="2000" autocomplete="off" placeholder="Write your question…" aria-label="Write your question"><button type="submit" aria-label="Send message">↑</button></div><div class="chat-attachment-row"><label class="chat-attach-button" for="chatAttachment">Attach file</label><input class="chat-attachment-input" id="chatAttachment" type="file" name="attachment"><span id="chatAttachmentName">Optional · max 10 MB</span></div><p class="chat-status" id="chatStatus" role="status" aria-live="polite"></p></form>
</div>
</section><button class="chat-launcher" type="button" aria-controls="chatPanel" aria-expanded="false"><span class="chat-launch-icon" aria-hidden="true"></span><span>Chat with us</span></button></aside>

